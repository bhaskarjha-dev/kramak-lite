{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kramak-lite-state",
  "title": "Kramak Lite State",
  "description": "State tracking for the Kramak Lite autonomous development engine.",
  "type": "object",
  "required": ["phase"],
  "properties": {
    "phase": {
      "type": "string",
      "enum": ["planning", "executing", "auditing", "waiting", "escalated", "complete"],
      "description": "Current lifecycle phase."
    },
    "nextAction": {
      "type": "string",
      "description": "Human-readable instruction for the next session. The most important cross-session field — tells the next model exactly what to do."
    },
    "productPhase": {
      "type": "string",
      "enum": ["BUILD", "SHIP", "ITERATE"],
      "description": "Current product lifecycle stage. Determines priority ordering."
    },
    "batchNumber": {
      "type": "integer",
      "minimum": 0,
      "description": "Current batch number. 0 indicates pre-first-batch (initialization)."
    },
    "active": {
      "type": ["string", "null"],
      "description": "ID of the currently executing Work Item, or null."
    },
    "queue": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered list of Work Item IDs to execute."
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "completedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "completedAt"]
      },
      "description": "Work Items completed in the current batch."
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["code-drift", "verification-fail", "scope-exceeded", "dependency-missing", "ambiguous-spec", "tool-error"]
          },
          "failedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "category", "failedAt"]
      },
      "description": "Work Items that failed in the current batch."
    },
    "metrics": {
      "type": "object",
      "properties": {
        "totalCompleted": { "type": "integer", "minimum": 0 },
        "totalFailed": { "type": "integer", "minimum": 0 },
        "consecutiveFailures": { "type": "integer", "minimum": 0 },
        "circuitBreakerTripped": { "type": "boolean" }
      },
      "description": "Cumulative execution metrics."
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "checkCommands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Commands to verify code correctness."
        },
        "detected": { "type": "boolean" }
      },
      "description": "Detected project toolchain and verification commands."
    },
    "projectStructure": {
      "type": "object",
      "properties": {
        "readme": { "type": ["string", "null"] },
        "roadmap": { "type": ["string", "null"] },
        "architecture": { "type": ["string", "null"] },
        "productSpec": { "type": ["string", "null"] },
        "conventions": { "type": ["string", "null"] },
        "discovered": { "type": "boolean" }
      },
      "description": "Discovered project documentation paths."
    },
    "perspectiveHistory": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5,
      "description": "Rolling window of last 5 perspective names taken during planning sessions. Used for diversity check (3+ consecutive identical = nudge to switch)."
    },
    "lastSession": {
      "type": "object",
      "properties": {
        "perspective": {
          "type": ["string", "null"],
          "description": "Perspective taken in the last planning session, e.g. 'Solution Architect because the data model needs restructuring before new features'."
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary of what was accomplished. Enables cross-session continuity without reading conversation history."
        },
        "model": {
          "type": "string",
          "description": "Which model ran the last session (e.g. 'Claude Opus 4.6', 'Gemini Flash')."
        },
        "batchNumber": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "description": "Context from the most recent session for continuity."
    },
    "humanTasksPending": {
      "type": "boolean",
      "description": "True when HUMAN-TASKS.md has unresolved tasks requiring human action."
    },
    "lastVisionAssessment": {
      "type": "object",
      "properties": {
        "batchNumber": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "findings": { "type": "string", "description": "Brief summary of what the 5-lens vision assessment found." }
      },
      "description": "Tracks when the last Strategic Vision assessment was run."
    },
    "lastAudit": {
      "type": "object",
      "properties": {
        "batchNumber": { "type": "integer" },
        "verdict": {
          "type": "string",
          "enum": ["pass", "pass-with-fixes"]
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "fixesApplied": { "type": "integer", "minimum": 0 },
        "strategicConcerns": { "type": ["string", "null"] }
      },
      "description": "Results of the most recent audit."
    },
    "escalation": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" },
        "failedWIs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "description": "Diagnosis when circuit breaker trips."
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of parallel agents. Default 1 (sequential)."
        }
      },
      "description": "Multi-agent dispatch configuration."
    },
    "deploymentBlocked": {
      "type": "boolean",
      "description": "True when SHIP work is blocked by human tasks and BUILD fallback is active."
    },
    "currentBranch": {
      "type": ["string", "null"],
      "description": "Current git branch for the active batch."
    }
  }
}
